PORT=5000

MONGO_URI=

RESEND_API_KEY=

# Eventbrite server-side connection. Keep every value below in backend/.env
# locally and in the Render backend service only.
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_EVENT_IDS=
EVENTBRITE_ORGANIZATION_ID=
EVENTBRITE_CLIENT_ID=
EVENTBRITE_CLIENT_SECRET=
EVENTBRITE_REDIRECT_URI=http://localhost:5001/api/eventbrite/oauth/callback
# Generate separately from the encryption key: openssl rand -hex 32
EVENTBRITE_WEBHOOK_TOKEN=
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/gmail/oauth/callback
EMAIL_REPLY_TO=
# Generate with: openssl rand -base64 32
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=

MEETUP_API_KEY=

APOLLO_API_KEY=

# Private server-side key. Each live verification uses Emailable credits.
EMAILABLE_API_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=

X_API_KEY=
X_API_SECRET=

# Jarvis is fully functional with its verified workspace summaries by default.
# Enable an OpenAI-written response only after you intentionally provide a key.
OPENAI_API_KEY=
JARVIS_OPENAI_ENABLED=false
JARVIS_OPENAI_MODEL=gpt-4.1-mini
JARVIS_RESEARCH_OPENAI_MODEL=gpt-5.6-sol

# Point this at the root of your local Obsidian vault. Jarvis writes notes only
# when both the path is set and this explicit opt-in is true.
OBSIDIAN_VAULT_PATH=
JARVIS_OBSIDIAN_MEMORY_ENABLED=false

# Deployed Jarvis memory: set source to cloud on Render. The local bridge uses
# this secret to push approved Markdown notes from your Mac to MongoDB.
JARVIS_MEMORY_SOURCE=local
JARVIS_MEMORY_SYNC_SECRET=

# Developer-only access to the software change approval queue.
DEVELOPMENT_APPROVAL_SECRET=
